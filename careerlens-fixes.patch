+def _parse_markerless_entries(canonical_sec: str, sec_prefix: str, lines: list[str]) -> list[SourceEntry]:
+    """Parse a section whose source has NO bullet markers (common in student resumes).
+
+    1. Merge a line into the previous one only when it is a real wrap (previous text has no
+       terminal punctuation, or this line starts lowercase).
+    2. Split into sentences; every sentence becomes one bullet.
+    3. A short sentence ending in ':' is an entry title. For projects, a sentence such as
+       'Created a Parking Management System using C ...' starts a new entry.
+    Nothing is invented: titles and bullets are substrings of the source text.
+    """
+    logical: list[str] = []
+    for line in lines:
+        if logical and (not re.search(r"[.!?:]$", logical[-1]) or line[:1].islower()):
+            logical[-1] = f"{logical[-1]} {line}".strip()
+        else:
+            logical.append(line)
+
+    sentences: list[str] = []
+    for chunk in logical:
+        sentences.extend(p.strip() for p in _SENTENCE_SPLIT_RE.split(chunk) if p.strip())
+
+    entries: list[SourceEntry] = []
+    current: Optional[SourceEntry] = None
