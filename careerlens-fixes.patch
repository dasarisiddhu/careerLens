+"""The ATS number is computed by plain code; the LLM only writes verdict/suggestion text.
+/api/resume/ats-score therefore returns the same score with zero Groq calls."""
+import asyncio
+import json
+import os
+import unittest
+from unittest.mock import AsyncMock, patch
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-tests-0123456789")
+os.environ.setdefault("STRIPE_WEBHOOK_SECRET", "whsec_test")
+
+from routers import resume as resume_router
+
+RESUME = (
+    "Rohan Verma\nSKILLS\nPython, SQL, PyTorch, scikit-learn, XGBoost, Docker, FastAPI, MLflow, AWS\n"
+    "EXPERIENCE\nMachine Learning Intern\n- Built a churn model with XGBoost on 500K+ records.\n"
+    "- Containerized the prediction service with Docker and FastAPI.\n"
+)
+JD = "We need a machine learning engineer with Python, PyTorch, Docker, Kubernetes, Spark, SQL and MLflow experience."
+
+
+class AtsScoreWithoutLlm(unittest.TestCase):
+    def test_route_is_registered(self):
+        paths = {getattr(r, "path", "") for r in resume_router.router.routes}
+        self.assertIn("/api/resume/ats-score", paths | {"/api/resume" + p for p in paths})
+
+    def test_never_calls_groq(self):
+        with patch.object(resume_router, "call_groq", new=AsyncMock(side_effect=AssertionError("LLM called"))):
+            out = resume_router.run_deterministic_ats_check(RESUME, JD)
+        self.assertFalse(out["llm_used"])
+        self.assertIsInstance(out["ats_score"], int)
+
+    def test_score_equals_llm_path_when_llm_fails(self):
+        with patch.object(resume_router, "call_groq", new=AsyncMock(side_effect=ValueError("429"))):
+            llm_path = asyncio.run(resume_router.run_brutal_ats_check(RESUME, JD))
+        self.assertEqual(resume_router.run_deterministic_ats_check(RESUME, JD)["ats_score"], llm_path["ats_score"])
+
+    def test_score_ignores_whatever_the_llm_says(self):
+        hallucinated = json.dumps({"ats_score": 3, "matched_keywords": [], "missing_keywords": ["x"] * 30,
+                                   "honest_verdict": "Terrible.", "suggestions": ["a"], "verdict": "not qualified"})
+        with patch.object(resume_router, "call_groq", new=AsyncMock(return_value=hallucinated)):
+            llm_path = asyncio.run(resume_router.run_brutal_ats_check(RESUME, JD))
+        self.assertEqual(resume_router.run_deterministic_ats_check(RESUME, JD)["ats_score"], llm_path["ats_score"])
+
+
+if __name__ == "__main__":
+    unittest.main()
