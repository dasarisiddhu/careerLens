+    if not re.fullmatch(r"\d+(?:\.\d+)+", raw):
+        return None
+    m = _VERSION_PRECEDER_RE.search(str(text or "")[max(0, start - 24):start])
+    if not m:
+        return None
+    return (m.group(1).lower().rstrip("."), raw)
+
+
